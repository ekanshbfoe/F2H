# Copy to supabase/.env (git ignored). Server side secrets only; nothing here ships in the app.
# Pushed to Edge Functions with: npx supabase secrets set --env-file supabase/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used only by `npm run bootstrap:admin` on your machine. Find it in Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
