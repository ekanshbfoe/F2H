# Copy to supabase/.env (git ignored). Server secrets only: never in the app, on EAS or in git.
# `npm run setup:backend` reads this file and pushes what the backend needs.

# Supabase dashboard -> Project Settings -> Database: the password you chose when you made the
# project (reset it there if you lost it).
SUPABASE_DB_PASSWORD=

# Supabase dashboard -> Project Settings -> API: the service_role key. Full database access.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud console -> APIs & Services -> Credentials -> your OAuth client (type Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
