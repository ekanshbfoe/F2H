{
  "expo": {
    "name": "F2H",
    "slug": "f2h",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "f2h",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ekansh.f2h"
    },
    "android": {
      "package": "com.ekansh.f2h",
      "adaptiveIcon": {
        "backgroundColor": "#3575DF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3575DF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "F2H reads your contacts only when you choose to import some into your encrypted vault."
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eebcfc5e-2c28-4bcc-886f-3cf61fbb46d4"
      }
    }
  }
}
