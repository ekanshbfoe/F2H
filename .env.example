# Copy to .env (git ignored) and fill in. Every value here is public by design: it ships inside
# the app, and row level security guards the anon key. Server secrets go in supabase/.env.
# After any change, run `npm run eas:env` so EAS cloud builds get the same values.

# Supabase dashboard -> Project Settings -> API: the project URL and the anon (public) key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Printed by `npx eas-cli init` (a UUID). Needed for EAS builds and push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Your own app id, reverse domain style, lowercase. It becomes the Android package and the
# iOS bundle id. Pick it once: changing it later makes a different app on the phone.
F2H_APP_ID=com.yourname.f2h

# Development only: 1 lets you take screenshots in Expo Go. Release builds ignore it.
EXPO_PUBLIC_ALLOW_SCREENSHOTS=
